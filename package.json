{
  "name": "ishtar-storefront",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "media:upload": "tsx scripts/upload-demo-media.ts",
    "media:apply": "tsx scripts/apply-demo-media.ts",
    "db:demo-media": "tsx scripts/apply-demo-pexels-media.ts",
    "db:backfill-sold-count": "tsx scripts/backfill-sold-count.ts",
    "db:audit-commerce": "tsx scripts/audit-commerce-integrity.ts",
    "db:backfill-delivery-fee-status": "tsx scripts/backfill-delivery-fee-status.ts",
    "db:backfill-inventory-ledger": "tsx scripts/backfill-inventory-ledger.ts",
    "telegram:test": "tsx scripts/test-telegram.ts",
    "brand:check": "node scripts/check-ishtar-brand.mjs",
    "test:checkout-client": "node --import tsx --test tests/checkout-recovery.test.tsx",
    "test:commerce": "node --import tsx --test tests/commerce.test.ts",
    "test:integration": "node --require ./tests/runtime/server-marker.cjs --import tsx --test tests/checkout.integration.test.ts",
    "test:hero": "node --require ./tests/runtime/server-marker.cjs --import tsx --test tests/hero-settings.test.ts tests/hero-render.test.tsx tests/hero-rotation.test.tsx tests/hero-editor.test.tsx tests/hero-view-rotation.test.tsx",
    "test:admin-safety": "node --require ./tests/runtime/server-marker.cjs --import tsx --test tests/admin-permissions.test.ts tests/postgres-target.test.ts",
    "test:concurrency": "node --require ./tests/runtime/server-marker.cjs --import tsx --test tests/checkout.concurrency.test.ts",
    "test:notifications": "node --require ./tests/runtime/server-marker.cjs --import tsx --test tests/notifications.test.ts tests/order-activity.test.tsx",
    "test:dashboard": "node --require ./tests/runtime/server-marker.cjs --import tsx --test tests/dashboard.test.ts",
    "test:search": "node --import tsx --test tests/search-submit.test.tsx",
    "test:wishlist": "node --import tsx --test tests/wishlist.test.tsx tests/wishlist-page.test.tsx"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.7",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "motion": "^12.43.0",
    "next": "16.2.7",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-socket": "0.2.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.7",
    "prisma": "6.19.0",
    "react-test-renderer": "19.2.7",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
