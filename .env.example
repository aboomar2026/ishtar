DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/ishtar?schema=public"

# Admin dashboard — internal staff login. Never commit real values.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-locally"
ADMIN_NAME="ISHTAR Admin"
ADMIN_SESSION_SECRET="replace-with-random-secret"

# Public deployed origin for Telegram order links, SEO and invoice QR codes.
# In Netlify set this for BOTH Builds and Functions, then redeploy.
NEXT_PUBLIC_SITE_URL="https://ishtar-store.netlify.app"
# For local development only, override with http://localhost:3000.


# Telegram admin notifications — optional. Never commit real values.
# Create a bot from @BotFather, press Start on the bot, then use getUpdates to find chat_id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Cloudinary — server-side image uploads for products & banners.
# API secret is server-only; never expose it to the client. Placeholders only.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_FOLDER="ishtar/dev"

# Optional — only needed by scripts/upload-demo-media.ts when you let it fetch
# demo images from the Pexels API instead of downloading them manually.
# Get a free key at https://www.pexels.com/api/. Never commit a real value.
PEXELS_API_KEY=""
# White-label storefront identity.
# Supported values: ishtar | saad | bab-al-hara | obbeh | madar
# Each deployment can use the same database and Cloudinary account while presenting a different demo identity.
NEXT_PUBLIC_STORE_BRAND="ishtar"

# Keep unverified imported ratings/order counters hidden for ISHTAR.
NEXT_PUBLIC_SHOW_CATALOG_METRICS="false"
# NEXT_PUBLIC_SITE_URL must be the public HTTPS origin before sitemap/QR use.

# Optional: keep a non-public deployment out of search. Netlify previews set this automatically.
SEO_NOINDEX="false"
# Optional Google Search Console verification token (HTML tag content value only).
GOOGLE_SITE_VERIFICATION=""
